{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/auroraseven77/auroraseven77/osint-toolkit/schema/observation.schema.json",
  "title": "TUU OSINT Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "timestamp", "target", "entity_type", "value", "confidence", "status"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "query": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "target": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "enum": ["dns", "http_header", "tls_cert", "robots", "ip", "asn", "identity", "evidence"]},
    "value": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_url": {"type": ["string", "null"], "format": "uri"},
    "hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["ok", "error", "skipped"]}
  }
}
